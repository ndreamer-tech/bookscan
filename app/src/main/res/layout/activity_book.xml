<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111318">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/bookBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="←" />

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bookShoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 이어 찍기" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#8B93A1"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pageGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/pageTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1A1E26"
        android:visibility="gone">

        <Button
            android:id="@+id/pageUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀ 앞으로" />

        <Button
            android:id="@+id/pageDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="뒤로 ▶" />

        <Button
            android:id="@+id/pageDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="삭제" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#171B22"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/actImport"
            style="@style/BookAction">
            <TextView style="@style/BookActionIcon" android:text="🖼" />
            <TextView style="@style/BookActionText" android:text="가져오기" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actText"
            style="@style/BookAction">
            <TextView style="@style/BookActionIcon" android:text="🔤" />
            <TextView style="@style/BookActionText" android:text="텍스트 인식" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actShare"
            style="@style/BookAction">
            <TextView style="@style/BookActionIcon" android:text="↗" />
            <TextView style="@style/BookActionText" android:text="공유하기" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actPdf"
            style="@style/BookAction">
            <TextView style="@style/BookActionIcon" android:text="📄" />
            <TextView style="@style/BookActionText" android:text="PDF 만들기" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actMore"
            style="@style/BookAction">
            <TextView style="@style/BookActionIcon" android:text="⋯" />
            <TextView style="@style/BookActionText" android:text="더보기" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
