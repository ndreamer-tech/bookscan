<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 대화상자 — 단추가 바탕에 묻혀 안 보이던 것을 막는다 -->
    <style name="BookDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">#5AA9FF</item>
        <item name="colorAccent">#5AA9FF</item>
        <item name="android:textColor">#F2F5FA</item>
        <item name="android:textColorPrimary">#F2F5FA</item>
        <item name="android:textColorSecondary">#C9D1DC</item>
        <item name="buttonBarPositiveButtonStyle">@style/BookDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BookDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/BookDialogButton</item>
    </style>

    <style name="BookDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#5AA9FF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.BookScan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/BookDialog</item>
        <item name="materialAlertDialogTheme">@style/BookDialog</item>
        <item name="colorPrimary">#2E4057</item>
        <item name="colorPrimaryVariant">#1F2C3D</item>
        <item name="colorSecondary">#2ECC71</item>
        <item name="android:statusBarColor">#000000</item>
    </style>

    <!-- 책 화면 아래 도구줄 한 칸 -->
    <style name="BookAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 더보기 시트의 한 칸 -->
    <style name="SheetAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BookActionIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#E6EAF2</item>
    </style>

    <style name="BookActionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#AAB2C0</item>
    </style>
</resources>
